# ── 시스템 / 툴링 ────────────────────────────────────────────────────
.DS_Store
.env
__pycache__/
*.pyc
.python-version

# ── 로컬 수집 데이터 전체 (2026-10-15 결정) ─────────────────────────
# 저장소에는 코드·계약·문서만 올린다. 시장 데이터는 각자 API 키로
# `cio refresh` 해서 받는다. 컨센서스 history 처럼 다시 받을 수 없는 시점
# 기록도 이 PC 에만 남는다 — 저장소는 백업이 아니다.
# data/ 에는 원문(raw)·로그·캐시와 판단 초안이 섞인다. 초안 이름이 규칙을
# 비껴가 보유 수량·평단이 담긴 파일이 커밋된 적이 있어(data/pharmaresearch-*)
# 폴더째 막는다.
knowledge/
data/

# ── 개인 투자 정책 ───────────────────────────────────────────────────
# 월소득·목표수익·최대손실 등 민감 재무정보 포함
config/investor-policy.json

# ── 개인 포트폴리오 (수량·평가금액·손익 상세) ───────────────────────
knowledge/portfolio/holdings.csv
knowledge/portfolio/trades/
knowledge/portfolio/decisions/

# ── CIO 세션 컨텍스트 및 평가 기록 ──────────────────────────────────
# 판단 시점의 정책 지문·포트폴리오 스냅샷 포함
knowledge/contexts/
knowledge/assumptions/
knowledge/assessments/
knowledge/evaluations/
knowledge/evidence/
knowledge/quarantine/
knowledge/retired/

# ── 대시보드 생성물 (총자산·평가액·수량 포함) ──────────────────────
dashboard/data/

# ── 증권사 원본 명세 (계좌번호·성명·체결내역) ───────────────────────
거래내역서*.pdf
*거래내역서*.pdf
