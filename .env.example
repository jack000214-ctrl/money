# 발급·입력 안내: README.md의 "API 키와 SEC 연락처 설정"
# 값은 따옴표 없이 입력한다. 사용하지 않는 항목은 비워 둔다.

# 한국 주식 재무·공시: OpenDART 인증키
DART_API_KEY=

# 미국 주식 SEC EDGAR: 영문 이름과 연락 이메일 (예: Your Name you@example.com)
SEC_USER_AGENT=

# 한국 시세 대조·벤치마크 보완: KRX 인증키 (서비스별 활용신청·승인도 필요)
KRX_API_KEY=

# 한국 주식 대차잔고 보조 수집: 금융위원회_주식대차거래정보 활용신청 후 인증키
DATA_GO_KR_API_KEY=
